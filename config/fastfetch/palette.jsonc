// Preset zanvil — palette d un theme en blocs (zfetch palette [theme], zanvil-theme preview).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "none" },
  "modules": [
    { "type": "command", "key": "Thème", "text": "printf %s \"$ZF_THEME\"" },
    { "type": "command", "key": "Palette", "text": "printf %b \"$ZF_PALETTE\"" }
  ]
}
