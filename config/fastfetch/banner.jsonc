// Preset zanvil — banniere de demarrage (ZANVIL_STARTUP_BANNER=fastfetch) : court, sans commande lente.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "none" },
  "modules": [
    { "type": "command", "key": "zanvil", "text": "printf %s \"$ZF_VERSION · $ZF_THEME · $ZF_PROFILE\"" },
    "os", "uptime"
  ]
}
