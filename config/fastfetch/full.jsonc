// Preset zanvil — complet. Lance par zfetch (couleurs et logo passes en arguments).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    "title", "separator",
    "os", "host", "kernel", "uptime", "packages", "shell", "terminal", "cpu", "memory", "disk", "battery",
    "break",
    { "type": "command", "key": "zanvil", "text": "printf %s \"$ZF_VERSION\"" },
    { "type": "command", "key": "Thème", "text": "printf %s \"$ZF_THEME\"" },
    { "type": "command", "key": "Profil", "text": "printf %s \"$ZF_PROFILE\"" },
    { "type": "command", "key": "Kube", "text": "printf %s \"$ZF_KUBE\"" },
    { "type": "command", "key": "Mise à jour", "text": "printf %s \"$ZF_UPDATE\"" },
    { "type": "command", "key": "Modules", "text": "printf %s \"$ZF_MODULES\"" },
    "break", "colors"
  ]
}
